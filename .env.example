# Copy (do not rename) to .env, which is git-ignored and loaded automatically, or export these
# in your shell. Never commit a real key. Values need no quotes.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your-api-key
# Max output tokens per model call (keeps runs within the free tier's tokens-per-minute limit)
LLM_MAX_TOKENS=800
# OpenAlex (only needed by code that queries OpenAlex)
OPENALEX_API_KEY=your-openalex-key
