# Copy to .env (git-ignored) or export these in your shell. Never commit a real key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=your-tool-capable-model
LLM_API_KEY=your-api-key
# Max output tokens per model call (Groq's free tier rejects values above 1000)
LLM_MAX_TOKENS=800
# OpenAlex (only needed by code that queries OpenAlex)
OPENALEX_API_KEY=your-openalex-key
